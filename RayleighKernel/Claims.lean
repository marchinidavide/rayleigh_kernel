abbrev MainOptimizerData := Analysis.HalfLineH1.MainOptimizerData

private theorem inverse_rescale_eq (L : ℝ) (hL : 0 < L)
    (u : Analysis.HalfLineH1) :
    (u.rescale L hL).rescale L⁻¹ (inv_pos.mpr hL) = u := by
  apply Analysis.HalfLineH1.ext_value
  apply MeasureTheory.Lp.ext
  have hrep : ∀ x : ℝ,
      ((u.rescale L hL).rescale L⁻¹ (inv_pos.mpr hL)).continuousRep x =
        u.continuousRep x := by
    intro x
    by_cases hx : x ≤ 0
    · rw [((u.rescale L hL).rescale L⁻¹ (inv_pos.mpr hL)).continuousRep_eq_zero_of_nonpositive hx,
        u.continuousRep_eq_zero_of_nonpositive hx]
    · have hx' : x ∈ Set.Ici 0 := le_of_not_ge hx
      rw [(u.rescale L hL).continuousRep_rescale (inv_pos.mpr hL) hx']
      change L⁻¹ * (u.rescale L hL).continuousRep (L⁻¹ * x) = u.continuousRep x
      rw [u.continuousRep_rescale hL
        (show 0 ≤ L⁻¹ * x from mul_nonneg (le_of_lt (inv_pos.mpr hL)) hx')]
      simp [RayleighKernel.rescale, hL.ne']
  exact (u.rescale L hL).rescale L⁻¹ (inv_pos.mpr hL) |>.continuousRep_ae_eq_value.symm.trans
    (Filter.Eventually.of_forall hrep) |>.trans u.continuousRep_ae_eq_value

theorem admissible_rescale_iff {L : ℝ} (hL : 0 < L) (u : Analysis.HalfLineH1) :
    (u.rescale L hL).IsAdmissible 1 ↔ u.IsAdmissible L := by
  constructor
  · intro hu
    have hback := (u.rescale L hL).rescale_isAdmissible (inv_pos.mpr hL) hu
    have hparam : 1 / L⁻¹ = L := by field_simp
    rw [hparam] at hback
    rw [inverse_rescale_eq L hL u] at hback
    exact hback
  · intro hu
    have hforward := u.rescale_isAdmissible hL hu
    simpa [div_self hL.ne'] using hforward

theorem lambda_scaling {L : ℝ} (hL : 0 < L) :
    Analysis.Lambda L = L⁻¹ ^ 2 * Analysis.Lambda 1 := by
  rw [Analysis.HalfLineH1.Lambda_eq_lambdaStar_div_sq hL,
    Analysis.HalfLineH1.Lambda_eq_lambdaStar_div_sq (by norm_num : (0 : ℝ) < 1)]
  field_simp

theorem mainOptimizer (L : ℝ) (hL : 0 < L) : MainOptimizerData L hL :=
  Analysis.HalfLineH1.mainOptimizerTheorem L hL

end RayleighKernel.Claims
